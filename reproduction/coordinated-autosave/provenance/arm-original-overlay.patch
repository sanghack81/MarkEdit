   @IBOutlet weak var postponeUpdateItem: NSMenuItem?
   @IBOutlet weak var ignoreUpdateItem: NSMenuItem?
 
+  private var probeBaselineWritten = false
+
+  @objc private func writeProbeWindowSnapshot(_ timer: Timer) {
+    guard let path = UserDefaults.standard.string(forKey: "markedit-probe-documents-log") else {
+      return
+    }
+
+    let titles = NSApp.windows.filter { $0.isVisible }.map { $0.title }
+    let snapshot: [String: Any] = ["window_titles": titles, "heartbeat": Date().timeIntervalSince1970]
+    if let data = try? JSONSerialization.data(withJSONObject: snapshot, options: [.prettyPrinted, .sortedKeys]) {
+      try? data.write(to: URL(fileURLWithPath: path + ".windows.json"), options: .atomic)
+    }
+
+    if !probeBaselineWritten && titles.contains("existing.md") {
+      probeBaselineWritten = true
+      let records: [[String: Any]] = NSDocumentController.shared.documents.map { document in
+        [
+          "file_url": document.fileURL?.path ?? "",
+          "window_titles": document.windowControllers.compactMap { $0.window?.title },
+          "is_document_edited": document.isDocumentEdited,
+          "has_unautosaved_changes": document.hasUnautosavedChanges,
+          "is_outdated": (document as? EditorDocument)?.isOutdated ?? false,
+          "is_content_ready": (document as? EditorDocument)?.isContentReady ?? false,
+          "string_value": (document as? EditorDocument)?.stringValue ?? "",
+        ]
+      }
+      if let data = try? JSONSerialization.data(withJSONObject: records, options: [.prettyPrinted, .sortedKeys]) {
+        try? data.write(to: URL(fileURLWithPath: path), options: .atomic)
+      }
+    }
+  }
+
   private var appearanceObservation: NSKeyValueObservation?
   private var settingsWindowController: NSWindowController?
 
