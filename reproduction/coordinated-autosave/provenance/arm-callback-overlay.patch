+          "is_content_ready": (document as? EditorDocument)?.isContentReady ?? false,
+          "string_value": (document as? EditorDocument)?.stringValue ?? "",
+        ]
+      }
+      if let data = try? JSONSerialization.data(withJSONObject: records, options: [.prettyPrinted, .sortedKeys]) {
